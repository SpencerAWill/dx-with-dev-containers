{
  "name": "SnapSort Dev Container",
  "dockerComposeFile": "docker-compose.yml",
  "service": "devcontainer",
  "initializeCommand": "bash ${localWorkspaceFolder}/.devcontainer/init.sh",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "24"
    },
    "ghcr.io/devcontainers/features/dotnet:2": {},
    "ghcr.io/jlaundry/devcontainer-features/azure-functions-core-tools:1": {},
    "ghcr.io/anthropics/devcontainer-features/claude-code:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {
      "installDirectlyFromGitHubRelease": true,
      "version": "latest"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "editorconfig.editorconfig",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "ms-dotnettools.csdevkit",
        "ms-azuretools.vscode-azurefunctions",
        "ms-azuretools.vscode-azurestorage",
        "ms-mssql.mssql",
        "RodrigoPiccelli.servicebus-emulator-explorer"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.codeActionsOnSave": {
          "source.fixAll.eslint": "explicit"
        },
        "terminal.integrated.defaultProfile.linux": "zsh",
        "terminal.integrated.profiles.linux": {
          "bash": {
            "path": "bash",
            "icon": "terminal-bash"
          },
          "zsh": {
            "path": "zsh"
          }
        }
      }
    }
  },
  "remoteUser": "vscode",
  "forwardPorts": [5173, 5000, 7071, 8081, 19000, 19001, 19002],
  "portsAttributes": {
    "5173": {
      "label": "web-app (Vite Dev Server)",
      "onAutoForward": "notify"
    },
    "5000": {
      "label": "web-api (HTTP)",
      "onAutoForward": "notify"
    },
    "7071": {
      "label": "Azure Functions (worker)",
      "onAutoForward": "notify"
    },
    "8081": {
      "label": "mobile (Expo Metro)",
      "onAutoForward": "notify"
    },
    "19000": {
      "label": "mobile (Expo Dev)",
      "onAutoForward": "silent"
    },
    "19001": {
      "label": "mobile (Expo Dev Tools)",
      "onAutoForward": "silent"
    },
    "19002": {
      "label": "mobile (Expo Dev Tools UI)",
      "onAutoForward": "silent"
    }
  },
  "workspaceFolder": "/workspace",
  "postCreateCommand": {
    "git-worktree-config": "git config --global --add safe.directory /workspace && git config --global worktree.useRelativePaths true && git config --global gc.auto 0",
    "dotnet-tools": "dotnet tool restore",
    "dotnet-restore": "dotnet restore SnapSort.slnx",
    "node": "pnpm install"
  },
  "postStartCommand": {
    "ef-migrate": "dotnet ef database update --project libs/data --startup-project apps/web-api"
  },
  "postAttachCommand": "scripts/welcome.sh"
}
