{
  "name": "snapsort",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "web": "pnpm --filter web-app dev",
    "web:build": "pnpm --filter web-app build",
    "mobile": "pnpm --filter mobile start",
    "mobile:tunnel": "scripts/mobile-tunnel.sh",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6"
  }
}
